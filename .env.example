# Copy to .env and fill in. See docs/configuration.md for every variable.
# `make run-*` loads this file automatically.

# --- api and worker ---
TANGENT_DATABASE_URL=postgres://tangent:tangent@localhost:5432/tangent?sslmode=disable
TANGENT_HTTP_ADDR=:8080
TANGENT_BASE_DOMAIN=localtest.me
TANGENT_OIDC_ISSUER=http://keycloak.localtest.me/realms/tangent
TANGENT_OIDC_AUDIENCE=tangent-api
TANGENT_LOG_LEVEL=debug

# --- api only ---
TANGENT_OPENCOST_URL=http://opencost.localtest.me

# --- worker only ---
TANGENT_GITHUB_APP_ID=
TANGENT_GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
TANGENT_GITHUB_ORG=
TANGENT_GITOPS_REPO=
TANGENT_ARGOCD_URL=http://argocd.localtest.me
TANGENT_ARGOCD_TOKEN_PATH=./secrets/argocd-token
TANGENT_WORKER_CONCURRENCY=4

# --- optional ---
OTEL_EXPORTER_OTLP_ENDPOINT=
